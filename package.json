{
  "name": "open-factura-ec",
  "version": "1.0.0",
  "description": "Librería moderna en TypeScript para facturación electrónica del SRI (Ecuador) en Node.js 20+",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "prepare": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "ec-sri-invoice-signer": "^1.8.2",
    "fast-xml-parser": "^5.5.9",
    "node-forge": "^1.3.1",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
